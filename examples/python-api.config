# Example: a Python HTTP API with no UI layer. Shows which keys to leave empty when a layer doesn't
# exist; the installer turns them into "(not used in this project)" and the agents skip those rules.
#   bash install/macos/install.sh --config examples/python-api.config /path/to/repo --dry-run

PROJECT_NAME="Orders API"
STACK="Python 3.12, FastAPI, SQLAlchemy 2, Alembic, pytest"
BASE_BRANCH="main"
LINT_CMD="ruff check ."
TEST_CMD="pytest -q"
PLANS_ROOT="docs/plans"
CONVENTIONS_DOC="docs/conventions.md"
PLANNER_AGENT="conductor-v2"
PLATFORM="macos"

SOURCE_ROOT="app/"
TEST_ROOT="tests/"
DOCS_ROOT="docs/architecture/"
DOCS_INDEX="docs/architecture/README.md"
DOC_STANDARD=""
MODEL_DIR="app/domain/"
PERSISTENCE_DIR="app/repositories/"
STATE_DIR="app/services/"
UI_DIR=""                 # no screens: an API's handlers live in CORE_DIR or STATE_DIR here
SHARED_UI_DIR=""
CORE_DIR="app/core/"
DATA_INTERFACE="OrderRepository"
PRIMARY_IMPL="SqlAlchemyOrderRepository"
TEST_IMPL="InMemoryOrderRepository"
SCHEMA_ARTIFACT="alembic/versions/"
SEED_FILE="tests/fixtures/seed.py"
DESIGN_SYSTEM_DOC=""

TYPECHECK_CMD="mypy app"
BUILD_CMD=""
RUN_CMD="uvicorn app.main:app --reload"

INVARIANT_CHECKS='`grep -rn "import sqlalchemy" app/services app/core` returns nothing; `alembic check` reports no pending model changes'
LONG_CMD_TIMEOUT=300
TEST_TIMEOUT=600
MAX_AGENT_MINUTES=90

GATEWAY_EXTRA="migrations-check|120|alembic check; format|60|ruff format|requires-args new-files-only"

PLANNER_MODEL=""
DEVELOPER_MODEL=""
REVIEWER_MODEL=""

COPILOT_WRAPPER=""
WAIT_MINUTES=15
MAX_RUN_MINUTES=120
STALL_MINUTES=30
REPEAT_STOP=40
