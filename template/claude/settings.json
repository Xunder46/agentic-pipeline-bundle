{
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "3600000",
    "BASH_MAX_TIMEOUT_MS": "3600000"
  },
  "permissions": {
    "allow": [
      "Bash({{RUNNER}}:*)",
      "Bash({{TIMEOUT_WRAPPER}}:*)",
      "Bash({{LINT_CMD}}:*)",
      "Bash({{TEST_CMD}}:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git switch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push -u origin feature/:*)",
      "Bash(gh pr create:*)",
      "Edit(.work/**)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin {{BASE_BRANCH}}:*)",
      "Bash(gh pr merge:*)",
      "Bash(copilot:*)"
    ]
  }
}
