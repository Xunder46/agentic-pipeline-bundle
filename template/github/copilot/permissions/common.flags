# Pipeline configuration and instructions are never agent-editable.
--deny-tool=write(.claude/**)
--deny-tool=write(.github/agents/**)
--deny-tool=write(.github/copilot/**)
--deny-tool=write(.git/**)
--deny-tool=write(AGENTS.md)
--deny-tool=write(CLAUDE.md)
--deny-tool=write(.work/runs/**)

# Keys never reach the agent's shell environment.
--secret-env-vars=COPILOT_PROVIDER_API_KEY,COPILOT_PROVIDER_BEARER_TOKEN,COPILOT_GITHUB_TOKEN,GH_TOKEN,GITHUB_TOKEN,OPENAI_API_KEY,ANTHROPIC_API_KEY,OPENROUTER_API_KEY
